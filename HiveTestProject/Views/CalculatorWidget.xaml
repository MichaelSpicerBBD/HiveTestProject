<UserControl x:Class="HiveTestProject.Views.CalculatorWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border Style="{StaticResource GlassPanel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Module Header -->
            <TextBlock Grid.Row="0" Text="Calculator" Style="{StaticResource HeaderText}" Margin="0,0,0,4" />

            <!-- Display -->
            <Border Grid.Row="1" Background="#0Affffff" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <TextBlock Text="{Binding Display}" Foreground="White"
                           FontSize="28" FontWeight="Light" FontFamily="Segoe UI"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Button Grid -->
            <Grid Grid.Row="2">
                <Grid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                        <Setter Property="Margin" Value="2" />
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: C  CE  ⌫  / -->
                <Button Grid.Row="0" Grid.Column="0" Content="C" Command="{Binding ClearCommand}" />
                <Button Grid.Row="0" Grid.Column="1" Content="CE" Command="{Binding ClearEntryCommand}" />
                <Button Grid.Row="0" Grid.Column="2" Content="&#xE750;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Command="{Binding BackspaceCommand}" />
                <Button Grid.Row="0" Grid.Column="3" Content="/" Foreground="{StaticResource AccentBrush}"
                        Command="{Binding OperatorCommand}" CommandParameter="/" />

                <!-- Row 1: 7  8  9  * -->
                <Button Grid.Row="1" Grid.Column="0" Content="7" Command="{Binding NumberCommand}" CommandParameter="7" />
                <Button Grid.Row="1" Grid.Column="1" Content="8" Command="{Binding NumberCommand}" CommandParameter="8" />
                <Button Grid.Row="1" Grid.Column="2" Content="9" Command="{Binding NumberCommand}" CommandParameter="9" />
                <Button Grid.Row="1" Grid.Column="3" Content="*" Foreground="{StaticResource AccentBrush}"
                        Command="{Binding OperatorCommand}" CommandParameter="*" />

                <!-- Row 2: 4  5  6  - -->
                <Button Grid.Row="2" Grid.Column="0" Content="4" Command="{Binding NumberCommand}" CommandParameter="4" />
                <Button Grid.Row="2" Grid.Column="1" Content="5" Command="{Binding NumberCommand}" CommandParameter="5" />
                <Button Grid.Row="2" Grid.Column="2" Content="6" Command="{Binding NumberCommand}" CommandParameter="6" />
                <Button Grid.Row="2" Grid.Column="3" Content="-" Foreground="{StaticResource AccentBrush}"
                        Command="{Binding OperatorCommand}" CommandParameter="-" />

                <!-- Row 3: 1  2  3  + -->
                <Button Grid.Row="3" Grid.Column="0" Content="1" Command="{Binding NumberCommand}" CommandParameter="1" />
                <Button Grid.Row="3" Grid.Column="1" Content="2" Command="{Binding NumberCommand}" CommandParameter="2" />
                <Button Grid.Row="3" Grid.Column="2" Content="3" Command="{Binding NumberCommand}" CommandParameter="3" />
                <Button Grid.Row="3" Grid.Column="3" Content="+" Foreground="{StaticResource AccentBrush}"
                        Command="{Binding OperatorCommand}" CommandParameter="+" />

                <!-- Row 4: +/-  0  .  = -->
                <Button Grid.Row="4" Grid.Column="0" Content="+/-" Command="{Binding NegateCommand}" />
                <Button Grid.Row="4" Grid.Column="1" Content="0" Command="{Binding NumberCommand}" CommandParameter="0" />
                <Button Grid.Row="4" Grid.Column="2" Content="." Command="{Binding DecimalCommand}" />
                <Button Grid.Row="4" Grid.Column="3" Content="=" Style="{StaticResource AccentButton}"
                        Command="{Binding EqualsCommand}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
