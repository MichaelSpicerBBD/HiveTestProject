<UserControl x:Class="HiveTestProject.Views.ClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border Style="{StaticResource GlassPanel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Module Header -->
            <TextBlock Grid.Row="0" Text="Clock" Style="{StaticResource HeaderText}" Margin="0,0,0,8" />

            <!-- Time Display -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CurrentTime}"
                           Style="{StaticResource LargeDisplay}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DayOfWeek}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="{Binding CurrentDate}"
                           Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
