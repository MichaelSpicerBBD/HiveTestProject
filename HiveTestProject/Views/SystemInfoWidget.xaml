<UserControl x:Class="HiveTestProject.Views.SystemInfoWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border Style="{StaticResource GlassPanel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Module Header -->
            <TextBlock Grid.Row="0" Text="System Info" Style="{StaticResource HeaderText}" Margin="0,0,0,8" />

            <!-- Info Rows -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Machine Name -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Machine" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding MachineName}" Foreground="White" FontSize="13"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" />
                    </Grid>

                    <!-- OS Version -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="OS" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding OsVersion}" Foreground="White" FontSize="12"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OsVersion}" />
                    </Grid>

                    <!-- Processor Count -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding ProcessorCount}" Foreground="White" FontSize="13"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" />
                    </Grid>

                    <!-- .NET Version -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text=".NET" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DotNetVersion}" Foreground="White" FontSize="12"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DotNetVersion}" />
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,6" />

                    <!-- Memory Used -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xEEA1;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Memory" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding MemoryUsedMb}" Foreground="White" FontSize="13"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Uptime -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Uptime" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Uptime}" Foreground="White" FontSize="13"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Process Count -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Processes" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding ProcessCount}" Foreground="White" FontSize="13"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
