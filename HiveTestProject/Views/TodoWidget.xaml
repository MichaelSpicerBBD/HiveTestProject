<UserControl x:Class="HiveTestProject.Views.TodoWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border Style="{StaticResource GlassPanel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with title and counter -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="To-Do" Style="{StaticResource HeaderText}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyText}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1} done">
                                <Binding Path="CompletedCount" />
                                <Binding Path="TotalCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button Content="&#xE894;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource GlassButton}" Padding="8,4" Margin="8,0,0,0"
                            Command="{Binding ClearCompletedCommand}" ToolTip="Clear Completed" />
                </StackPanel>
            </Grid>

            <!-- Input row -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource GlassTextBox}"
                         Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,6,0" />

                <Button Grid.Column="1"
                        Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource AccentButton}" Padding="10,6"
                        Command="{Binding AddTodoCommand}" ToolTip="Add Item" />
            </Grid>

            <!-- Todo list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Todos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6"
                                    Padding="8,6" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource GlassCheckBox}"
                                              IsChecked="{Binding IsCompleted}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Command="{Binding DataContext.ToggleCompletedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}" />

                                    <TextBlock x:Name="titleText" Grid.Column="1"
                                               Text="{Binding Title}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="13" FontFamily="Segoe UI"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <Button x:Name="deleteBtn" Grid.Column="2"
                                            Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource GlassButton}" Padding="6,2" FontSize="11"
                                            Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Delete"
                                            Opacity="0" />
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <Trigger SourceName="itemBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="itemBorder" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="#1effffff" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="deleteBtn" Property="Opacity" Value="1" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter TargetName="titleText" Property="TextDecorations" Value="Strikethrough" />
                                    <Setter TargetName="titleText" Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
